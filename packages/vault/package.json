{
  "name": "@altude/vault",
  "version": "0.0.0-alpha1",
  "description": "OWS-conformant encrypted key vault — TypeScript implementation of the Open Wallet Standard",
  "keywords": [
    "solana",
    "altude",
    "ows",
    "vault",
    "wallet",
    "open-wallet-standard"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@altude/core": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
