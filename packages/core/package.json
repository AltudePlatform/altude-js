{
  "name": "@altude/core",
  "version": "0.0.0-alpha1",
  "description": "Shared types, cryptographic primitives, and RPC client for the Altude SDK",
  "keywords": [
    "solana",
    "altude",
    "ows",
    "wallet"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "gill": "^0.8.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
