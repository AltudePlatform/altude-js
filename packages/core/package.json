{
  "name": "@altude/core",
  "version": "0.0.2",
  "description": "Shared types, cryptographic primitives, and RPC client for the Altude SDK",
  "keywords": [
    "solana",
    "altude",
    "ows",
    "wallet"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.native.js",
      "browser": "./dist/index.browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.native.js",
  "browser": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@scure/bip32": "^1.5.0",
    "@scure/bip39": "^1.4.0",
    "gill": "0.8.3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AltudePlatform/altude-js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
