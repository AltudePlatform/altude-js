{
  "name": "@altude/nft",
  "version": "0.0.0",
  "description": "Gasless NFT operations on Solana \u2014 Metaplex Core, compressed NFTs, DAS API",
  "keywords": [
    "solana",
    "altude",
    "nft",
    "metaplex",
    "cnft",
    "compressed"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@altude/core": "workspace:*",
    "@altude/gasstation": "workspace:*"
  },
  "peerDependencies": {
    "@metaplex-foundation/mpl-core": "^1.0.0",
    "@metaplex-foundation/mpl-bubblegum": "^4.0.0",
    "@metaplex-foundation/umi": "^1.0.0"
  },
  "peerDependenciesOptional": {
    "@metaplex-foundation/mpl-core": true,
    "@metaplex-foundation/mpl-bubblegum": true,
    "@metaplex-foundation/umi": true
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AltudePlatform/altude-js"
  }
}
