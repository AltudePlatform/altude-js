{
  "name": "altude-js",
  "version": "0.0.0",
  "private": true,
  "description": "Altude TypeScript SDK for Solana — OWS-conformant wallet infrastructure",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "manifest:check": "node scripts/release-manifest.mjs check",
    "manifest:sync": "node scripts/release-manifest.mjs sync",
    "test:react-native": "pnpm --filter @altude/core build && pnpm --filter @altude/gasstation build && node --conditions=react-native scripts/check-react-native-exports.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@solana/web3.js": "^1.98.4"
  }
}
